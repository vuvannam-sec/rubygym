# Local development configuration
# Copy this file to .env for Docker Compose, or to backend/.env when running
# the API directly. These values are examples only; do not reuse them in a
# real deployment.

MYSQL_ROOT_PASSWORD=rubygym-local-db
MYSQL_DATABASE=rubygym

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rubygym-local-db
DB_NAME=rubygym

JWT_SECRET=replace-this-local-development-secret
CORS_ORIGIN=http://localhost:8080
